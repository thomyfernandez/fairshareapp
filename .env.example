# Ejecutar python3 scripts/configurar.py para generar una clave local aleatoria.
JWT_SECRET=GENERAR_CON_scripts_configurar_py
JWT_EXPIRATION_MS=3600000
SPRING_PROFILES_ACTIVE=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Para SQL Server: SPRING_PROFILES_ACTIVE=sqlserver y DB_PASSWORD=<clave local>
